# ===================================================================
# ## Archivos de sistema operativo y editores comunes ##
# ===================================================================
.DS_Store
Thumbs.db
*.swp

# Carpetas de configuración de editores
.vscode/
.idea/

# ===================================================================
# ## .NET Core / Visual Studio ##
# ===================================================================
# Ignora las carpetas de compilación
[Bb]in/
[Oo]bj/

# Ignora archivos de configuración de usuario de Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignora los resultados de pruebas
TestResults/
*.trx

# Otros
*.DotSettings.user
appsettings.Development.json
secrets.json

# ===================================================================
# ## Node.js / React (Vite) ##
# ===================================================================
# Ignora la carpeta de dependencias
client/node_modules/

# Ignora la carpeta de producción
client/dist/

# Archivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de entorno (¡nunca subir secrets!)
client/.env
client/.env.local
client/.env.*.local

# Archivos de caché y temporales
client/.pnp/
client/.pnp.js
client/.vite/